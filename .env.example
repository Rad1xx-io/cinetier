TMDB_API_TOKEN=

# YouTube Data API v3 key (server-only). Get one from Google Cloud Console:
# create a project -> Enable APIs -> "YouTube Data API v3" -> Credentials -> Create API key.
YOUTUBE_API_KEY=

# IGDB (Twitch) credentials — the games catalog. Register an application at
# https://dev.twitch.tv/console/apps, then copy its Client ID and Client Secret.
# Both are server-only; the app exchanges them for a Bearer token automatically
# and refreshes it before expiry. Leave blank to fall back to the Steam store,
# which works but cannot serve titles it doesn't sell (Minecraft, Rocket League).
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Optional: use a pre-minted token instead of the client id/secret exchange.
IGDB_ACCESS_TOKEN=

# Optional: enables cloud accounts (magic-link sign-in + syncing rankings
# across devices via Supabase). Leave both blank to run in guest-only mode —
# everything keeps working exactly as before, stored only in localStorage.
# Both are safe to expose to the browser: Supabase access is governed by Row
# Level Security policies (see supabase/schema.sql), not by keeping this secret.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Set to "true" only on IPv6-only/NAT64 networks (e.g. a phone hotspot), where
# Next's image optimizer otherwise rejects every remote cover as a private IP.
# Leave blank in deployment.
ALLOW_LOCAL_IP_IMAGES=
