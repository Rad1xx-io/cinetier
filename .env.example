TMDB_API_TOKEN=

# YouTube Data API v3 key (server-only). Get one from Google Cloud Console:
# create a project -> Enable APIs -> "YouTube Data API v3" -> Credentials -> Create API key.
YOUTUBE_API_KEY=

# IGDB (Twitch) credentials — the games catalog. Register an application at
# https://dev.twitch.tv/console/apps, then copy its Client ID and Client Secret.
# Both are server-only; the app exchanges them for a Bearer token automatically
# and refreshes it before expiry. Leave blank to fall back to the Steam store,
# which works but cannot serve titles it doesn't sell (Minecraft, Rocket League).
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Optional: use a pre-minted token instead of the client id/secret exchange.
IGDB_ACCESS_TOKEN=

# Optional: enables cloud accounts (magic-link sign-in + syncing rankings
# across devices via Supabase). Leave both blank to run in guest-only mode —
# everything keeps working exactly as before, stored only in localStorage.
# Both are safe to expose to the browser: Supabase access is governed by Row
# Level Security policies (see supabase/schema.sql), not by keeping this secret.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Set to "true" only on IPv6-only/NAT64 networks (e.g. a phone hotspot), where
# Next's image optimizer otherwise rejects every remote cover as a private IP.
# Leave blank in deployment.
ALLOW_LOCAL_IP_IMAGES=

# Optional: PostHog product analytics. Both are inert when blank — the app's own
# event layer keeps working and simply has one fewer provider to send to.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Optional: which anime catalogue answers /api/anime/*. "anilist" (default) or
# "jikan" (MyAnimeList). The fallback exists because AniList has gone down
# before; flipping this needs a redeploy, not a release.
ANIME_SOURCE=

# Optional: the origin used for canonical URLs, Open Graph tags, the sitemap and
# every copied share link. Defaults to https://tierlistonline.com, so set it on
# a preview deployment or locally if those links should not point at production.
NEXT_PUBLIC_SITE_URL=

# Optional: the token from Google Search Console. The verification meta tag is
# omitted entirely while this is blank, rather than emitted empty.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional: affiliate ids appended to outbound "where to watch" links. Each is
# independent — an unset one yields a clean link rather than a broken one.
NEXT_PUBLIC_KINOPOISK_AFFILIATE_ID=
NEXT_PUBLIC_IVI_AFFILIATE_ID=
NEXT_PUBLIC_OKKO_AFFILIATE_ID=
NEXT_PUBLIC_AMAZON_AFFILIATE_ID=
NEXT_PUBLIC_APPLETV_AFFILIATE_ID=
